{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crown Circuit Hero",
  "type": "object",
  "required": ["id", "name", "archetype", "stats", "abilities"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "alias": {"type": "string"},
    "archetype": {"enum": ["Vanguard", "Bruiser", "Striker", "Assassin", "Controller", "Support", "Specialist"]},
    "secondaryArchetype": {"type": "string"},
    "stats": {
      "type": "object",
      "required": ["power", "defense", "speed", "skill", "control", "support"],
      "properties": {
        "power": {"type": "integer", "minimum": 0, "maximum": 100},
        "defense": {"type": "integer", "minimum": 0, "maximum": 100},
        "speed": {"type": "integer", "minimum": 0, "maximum": 100},
        "skill": {"type": "integer", "minimum": 0, "maximum": 100},
        "control": {"type": "integer", "minimum": 0, "maximum": 100},
        "support": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "abilities": {"type": "array", "minItems": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "portrait": {"type": "string"},
    "battleVisual": {"type": "string"}
  }
}
